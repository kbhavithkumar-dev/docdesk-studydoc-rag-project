# Demo mode runs the example questions against PostgreSQL without an API key.
DEMO_MODE=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

DB_HOST=127.0.0.1
DB_PORT=5433
# These sample passwords are for the local demo database.
POSTGRES_PASSWORD=local_setup_only_password
REPORT_READER_PASSWORD=local_reader_only_password
