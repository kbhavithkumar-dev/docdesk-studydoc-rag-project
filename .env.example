# Get an API key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
MIN_SIMILARITY=0.35

# Sample passwords for the loopback-only local database.
POSTGRES_PASSWORD=local_docdesk_admin_password
DOCDESK_DB_PASSWORD=local_docdesk_app_password
DOCDESK_DB_HOST=127.0.0.1
DOCDESK_DB_PORT=5434
# Optional: provide a complete PostgreSQL DSN for a managed database.
DATABASE_URL=

WEB_PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
APP_USERNAME=docdesk
APP_PASSWORD=
