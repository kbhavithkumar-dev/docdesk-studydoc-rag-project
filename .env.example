# Paste your Google AI Studio API key here after copying this file to .env.
GEMINI_API_KEY=

# One model creates the vectors. The other writes the answer.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite

# Keep this directory across server restarts.
DATA_DIR=data
MIN_SIMILARITY=0.35

# Local defaults. Set a strong password and add your hostname for a shared server.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
APP_USERNAME=docdesk
APP_PASSWORD=
